# Dinkel Portal — local environment template.
#
# Copy to .env and fill in. NEVER commit .env; this repository is public.
#   cp .env.example .env
#
# Every variable below is validated at startup by packages/shared/src/env.ts.
# The process refuses to boot on a missing or malformed value rather than
# failing later in a request.

# ---------------------------------------------------------------------------
# Yahoo Fantasy Sports API
# ---------------------------------------------------------------------------
# Access is NOT self-service. Apply at https://sports.yahoo.com/developer/access/
# and wait for approval; Yahoo issues credentials after review. Read-only by
# default, which is all this portal needs.
#
# Until credentials arrive, leave these placeholders and run in mock mode
# (YAHOO_MODE=mock) — the whole app is usable against the local mock server.
YAHOO_CLIENT_ID=replace-me
YAHOO_CLIENT_SECRET=replace-me

# Must match a redirect URI registered on the Yahoo app EXACTLY, including
# scheme, host, port, and path. Yahoo requires HTTPS, so local development uses
# a self-signed certificate — run `npm run certs` to generate one.
YAHOO_REDIRECT_URI=https://localhost:5173/auth/yahoo/callback

# mock  — no Yahoo account needed; serves synthetic fixtures from apps/mock-yahoo
# live  — talks to the real Yahoo API using the credentials above
YAHOO_MODE=mock

# Base URL of the mock server. Only read when YAHOO_MODE=mock.
# 127.0.0.1 rather than localhost on purpose: Node resolves localhost to ::1 on
# many systems, so an explicit address avoids depending on which family wins.
YAHOO_MOCK_BASE_URL=http://127.0.0.1:4310

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of the frontend. Used for cookie scope, CORS, and OAuth
# redirects back into the app.
APP_BASE_URL=https://localhost:5173

# development | test | production — controls error verbosity and cookie flags.
NODE_ENV=development

# Port the API listens on for local development.
API_PORT=4300

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Single DynamoDB table holding every Dinkel-owned entity plus short-lived
# Yahoo cache items.
DYNAMODB_TABLE_NAME=dinkel-portal-dev

# Local development points the SDK at DynamoDB Local. Leave empty when deployed
# so the SDK resolves the real regional endpoint.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# S3 bucket for temporary CSV uploads. Encrypted, lifecycle-deleted.
# Optional locally: imports fall back to in-memory handling when unset.
IMPORT_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Secrets — generate real values, do not reuse these
# ---------------------------------------------------------------------------
# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-32-random-bytes-base64

# Encrypts Yahoo access and refresh tokens at rest (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored Yahoo connection; users reconnect.
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# ---------------------------------------------------------------------------
# Recap prose generation (optional)
# ---------------------------------------------------------------------------
# Claude writes recap prose from a fact pack that this application computes.
# The model never calculates scores, rankings, or winners. Leave empty to
# disable prose generation entirely — recaps still build from templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
